<UserControl xmlns:controls="using:SolRIA.SAFT.Desktop.Controls" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:SolRIA.SAFT.Desktop.ViewModels"
             xmlns:models="using:SolRIA.SAFT.Parser.Models"
             x:Class="SolRIA.SAFT.Desktop.Views.StocksProductsPageView"
             x:DataType="vm:StocksProductsPageViewModel">
  <UserControl.Styles>
    <Style Selector="icons|MaterialIcon">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="Border.stock-summary-card">
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}"/>
    </Style>
    <Style Selector="TextBlock.stock-summary-label">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.stock-summary-value">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <controls:PageHeader Title="Existências" Description="Consulte, filtre e exporte os produtos e quantidades em inventário."/>
    <Grid Grid.Row="1" RowDefinitions="50,*,Auto" ColumnDefinitions="*,54,54">

    <TextBox Margin="2"
             Text="{Binding Filter, Mode=TwoWay}"
             PlaceholderText="Filtro">
      <TextBox.InnerRightContent>
        <Button Command="{Binding SearchCommand}"
                Classes="Primary" Padding="4"
                Theme="{DynamicResource BorderlessButton}"
                Width="{Binding $self.Bounds.Height}">
          <icons:MaterialIcon Kind="Magnify"/>
        </Button>
      </TextBox.InnerRightContent>
      <TextBox.KeyBindings>
        <KeyBinding Command="{Binding SearchCommand}" Gesture="Enter"/>
      </TextBox.KeyBindings>
    </TextBox>

    <Button Margin="2" Width="50" ToolTip.Tip="Limpar filtros"  Grid.Column="1"
            Command="{Binding SearchClearCommand}"
            VerticalAlignment="Stretch">
      <icons:MaterialIcon Kind="FilterRemoveOutline"/>
    </Button>

    <Button Grid.Column="2" Width="50" Margin="2" ToolTip.Tip="Ver relatório"
            Command="{Binding DoPrintCommand}"
            VerticalAlignment="Stretch">
      <icons:MaterialIcon Kind="FileDocumentOutline"/>
    </Button>

    <DataGrid ItemsSource="{Binding Products}"
              Grid.Row="1" Grid.ColumnSpan="3" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Categoria" Binding="{Binding ProductCategory}" x:DataType="models:Stock"/>
        <DataGridTextColumn Header="Código" Binding="{Binding ProductCode}" x:DataType="models:Stock"/>
        <DataGridTextColumn Header="Código EAN" Binding="{Binding ProductNumberCode}" x:DataType="models:Stock"/>
        <DataGridTextColumn Header="Descrição" Binding="{Binding ProductDescription}" x:DataType="models:Stock"/>
        <DataGridTemplateColumn Header="Quantidade" SortMemberPath="ClosingStockQuantity">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="models:Stock">
              <TextBlock Text="{Binding ClosingStockQuantity}" Classes="number"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Unidade" Binding="{Binding UnitOfMeasure}" x:DataType="models:Stock"/>
        <DataGridTemplateColumn Header="Valor" SortMemberPath="ClosingStockValue">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="models:Stock">
              <TextBlock Text="{Binding ClosingStockValue}" Classes="number"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <Border Theme="{DynamicResource CardBorder}"
            Grid.Row="2" Grid.ColumnSpan="3" Margin="2,10,2,2" Padding="16">
      <StackPanel Spacing="12">
        <TextBlock Text="Totais do inventário" FontWeight="SemiBold"
                   Foreground="{DynamicResource SemiColorText0}"/>
        <Grid ColumnDefinitions="*,*,1.3*" ColumnSpacing="12">
          <Border Classes="stock-summary-card">
            <StackPanel Spacing="6">
              <TextBlock Text="Produtos" Classes="stock-summary-label"/>
              <TextBlock Text="{Binding NumberProducts, StringFormat='N0'}"
                         Classes="stock-summary-value"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="stock-summary-card">
            <StackPanel Spacing="6">
              <TextBlock Text="Quantidade total" Classes="stock-summary-label"/>
              <TextBlock Text="{Binding TotalQuantity, StringFormat='N3'}"
                         Classes="stock-summary-value"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="stock-summary-card"
                  Background="{DynamicResource SemiColorPrimaryLight}">
            <StackPanel Spacing="6">
              <TextBlock Text="Valor total" Classes="stock-summary-label"/>
              <TextBlock Text="{Binding TotalValue, StringFormat='{}{0:N2} €'}"
                         Classes="stock-summary-value"
                         Foreground="{DynamicResource SemiColorPrimary}"/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
</UserControl>
